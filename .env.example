# Copy this file to .env and fill in the values below.
# Never commit your real .env file — it holds secrets.

# ---------------------------------------------------------------------------
# Adzuna API (free tier) — job source for gb/us/ca postings
# Get an App ID + App Key from https://developer.adzuna.com/
# ---------------------------------------------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Comma-separated Adzuna country codes to search
ADZUNA_COUNTRIES=gb,us,ca

# ---------------------------------------------------------------------------
# Gemini API — used to draft application messages and weekly LinkedIn posts
# Get a key from https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
# gemini-2.5-flash has been retired for new API users as of writing; if a
# newer model is available by the time you read this, check
# https://ai.google.dev/gemini-api/docs/models and update this value.
GEMINI_MODEL=gemini-3.6-flash

# ---------------------------------------------------------------------------
# WhatsApp delivery — choose ONE backend (or leave both blank for local fallback)
# ---------------------------------------------------------------------------

# Option A: official Meta WhatsApp Business Cloud API
# Get these from https://developers.facebook.com/apps (WhatsApp product)
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_TO_NUMBER=

# Option B: generic webhook-style backend (e.g. Blueticks or any provider
# that accepts a JSON POST). Get the URL/token from your provider's dashboard.
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=

# If neither option is configured, the digest is written to
# ./data/digests/ and printed to stdout instead — the pipeline stays
# fully testable without any WhatsApp account connected.

# ---------------------------------------------------------------------------
# Scheduling (used by src/scheduler.py)
# ---------------------------------------------------------------------------
TIMEZONE=Asia/Karachi
MORNING_RUN_TIME=09:00
EVENING_RUN_TIME=17:00
# Post drafter runs 3x/week on fixed days with a fixed topic per day
# (Tue = project spotlight, Thu = credential/skill, Sat = reflection) —
# only the time-of-day is configurable here.
POST_DRAFTER_TIME=10:00

# ---------------------------------------------------------------------------
# Matching / ranking tuning (optional — sensible defaults are used if blank)
# ---------------------------------------------------------------------------
# Kept low (5) so 2 runs/day stay comfortably under Gemini's free-tier cap
# of 20 requests/day per API key/model (each drafted posting = 1 request).
MAX_RESULTS_PER_DIGEST=5
# A title-keyword match is worth 3 points, a body-only match is worth 1.
# 4 requires roughly a title match, or several body matches, to count as
# relevant — raise this further if you still see noisy/unrelated postings.
MIN_MATCH_SCORE=4
SEEN_POSTING_COOLDOWN_DAYS=3
